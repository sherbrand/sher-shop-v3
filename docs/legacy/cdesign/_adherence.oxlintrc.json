      {
        "selector": "JSXOpeningElement[name.name='ButtonPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|as|href|target|rel|key|ref|className|style|children)$/]",
        "message": "<ButtonPill> doesn't accept that prop. Declared props: active, as, href, target, rel."
